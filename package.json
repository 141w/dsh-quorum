{
  "name": "dsh-quorum",
  "version": "0.3.1",
  "description": "Mechanism-enforced discipline layer for DeepSeek Harness agent teams: role cards, quorum termination, evidence-gated reports and cost budgets.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "node --check index.js && node --check client.js",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js",
    "smoke": "node test/publish-smoke.mjs",
    "smoke:install": "node test/publish-smoke.mjs --install"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "cordis",
    "agent-teams",
    "multi-agent",
    "governance",
    "budget",
    "quorum"
  ],
  "author": "Weiqi Wang",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/141w/dsh-quorum.git"
  },
  "bugs": {
    "url": "https://github.com/141w/dsh-quorum/issues"
  },
  "homepage": "https://github.com/141w/dsh-quorum#readme",
  "publishConfig": {
    "access": "public"
  }
}
